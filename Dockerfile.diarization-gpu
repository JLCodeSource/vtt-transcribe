# Multi-stage Dockerfile for vtt-transcribe WITH DIARIZATION + GPU (CUDA)
# Requires: nvidia-container-toolkit and the --gpus flag at run time
#
# Both stages use plain Ubuntu rather than an nvidia/cuda base image. The
# PyTorch cu132 wheels already ship every CUDA runtime library they need
# (cuBLAS, cuDNN, cuFFT, NCCL, ...) as nvidia-* pip packages, and the host
# driver (libcuda) is injected by nvidia-container-toolkit. A CUDA base image
# would carry a second, unused copy of those libraries (~3 GB) and pull in
# NVIDIA's apt repository, whose mirror syncs have broken CI builds.

# Build stage: Install dependencies and build
FROM ubuntu:24.04 AS builder

WORKDIR /app

# Install Python 3.12 (default for Ubuntu 24.04) and system dependencies required for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-dev \
    ffmpeg \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv

# Copy only dependency files first (for better layer caching)
COPY pyproject.toml uv.lock README.md ./

# Export the fully-resolved diarization requirements from uv.lock, split into
# torch/torchaudio (installed from the CUDA index) and everything else.
RUN uv export --format requirements-txt --no-hashes --no-emit-project --extra diarization \
        > /tmp/requirements-diarization.txt \
    && grep -E '^(torch|torchaudio)==' /tmp/requirements-diarization.txt > /tmp/requirements-torch.txt \
    && grep -v -E '^(torch|torchaudio)==' /tmp/requirements-diarization.txt > /tmp/requirements-rest.txt \
    && test "$(wc -l < /tmp/requirements-torch.txt)" -eq 2

# Create virtual environment with Python 3.12
RUN uv venv --python python3 /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv

# Install PyTorch + torchaudio with CUDA support in their own layer
# BOTH must come from the same CUDA index to ensure matching C++ ABI.
# torchaudio required by pyannote.audio 4.x for resampling
RUN uv pip install --no-cache -r /tmp/requirements-torch.txt --index-url https://download.pytorch.org/whl/cu132

# Install every other locked dependency (pyannote.audio, torchcodec, ...) exactly
# as resolved in uv.lock. --no-deps stops a fresh resolve from PyPI, which would
# otherwise replace the pinned torch 2.15 (pyannote.audio needs it) with the
# newest torch and its CUDA 13 libraries.
RUN uv pip install --no-cache --no-deps -r /tmp/requirements-rest.txt

# Copy source code
COPY vtt_transcribe ./vtt_transcribe

# Install the package itself; its dependencies are all installed above.
RUN uv pip install --no-cache --no-deps . \
    && python -c "import torch; v = torch.__version__; assert v.startswith('2.15.') and v.endswith('+cu132'), v"

# Prepare a copy of site-packages without the large dirs (for split COPY layers),
# and drop bytecode caches, which are regenerated on demand.
RUN find /opt/venv -name '__pycache__' -type d -prune -exec rm -rf {} + \
    && cp -a /opt/venv/lib/python3.12/site-packages /opt/venv/site-packages-rest \
    && rm -rf /opt/venv/site-packages-rest/nvidia \
              /opt/venv/site-packages-rest/torch \
              /opt/venv/site-packages-rest/torchaudio \
              /opt/venv/site-packages-rest/torchcodec

# Runtime stage: only Python, ffmpeg and the virtual environment
FROM ubuntu:24.04

# Configurable UID for non-root user (default 1000 for typical Linux desktops)
ARG USER_UID=1000

# Install Python runtime and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    libpython3-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user — Ubuntu base images ship 'ubuntu' at UID 1000,
# so remove it first to guarantee our user gets the target UID.
RUN existing_user=$(getent passwd "$USER_UID" | cut -d: -f1) \
    && if [ -n "$existing_user" ]; then userdel -r "$existing_user"; fi \
    ; useradd -m -u "$USER_UID" vttuser

# Copy virtual environment from builder in separate layers to keep each
# layer under Docker Hub's per-blob size limit (~4GB compressed limit)
#
# Layer 1: NVIDIA CUDA libraries from pip (cuDNN, cuFFT, cuBLAS, etc.)
COPY --from=builder /opt/venv/lib/python3.12/site-packages/nvidia /opt/venv/lib/python3.12/site-packages/nvidia
# Layer 2: PyTorch core
COPY --from=builder /opt/venv/lib/python3.12/site-packages/torch /opt/venv/lib/python3.12/site-packages/torch
# Layer 3: torchaudio + torchcodec
COPY --from=builder /opt/venv/lib/python3.12/site-packages/torchaudio /opt/venv/lib/python3.12/site-packages/torchaudio
COPY --from=builder /opt/venv/lib/python3.12/site-packages/torchcodec /opt/venv/lib/python3.12/site-packages/torchcodec
# Layer 4: All remaining packages (pyannote, speechbrain, vtt-transcribe, etc.)
# Uses the pre-stripped site-packages-rest from the builder stage
COPY --from=builder /opt/venv/site-packages-rest /opt/venv/lib/python3.12/site-packages
# Layer 5: entry points and venv config (no include/: headers are not needed at runtime)
COPY --from=builder /opt/venv/bin /opt/venv/bin
COPY --from=builder /opt/venv/pyvenv.cfg /opt/venv/pyvenv.cfg
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory for user files
WORKDIR /workspace

# Switch to non-root user
USER vttuser

# Ensure Python output is unbuffered
ENV PYTHONUNBUFFERED=1

# Expose the GPU to the container via nvidia-container-toolkit
# (will use CUDA when --gpus is passed)
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Set entrypoint (no CMD - let stdin detection or user args determine behavior)
ENTRYPOINT ["vtt"]
