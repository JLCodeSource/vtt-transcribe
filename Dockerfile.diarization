# Dockerfile for vtt-transcribe WITH DIARIZATION (CPU)
# Single stage — each pip install is its own layer

FROM python:3.13-slim

WORKDIR /app
ARG USER_UID=1000

# System deps (ffmpeg for audio, gcc/g++ for building native extensions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy dependency metadata early for dependency-layer caching
COPY pyproject.toml uv.lock README.md ./

# Export the fully-resolved diarization requirements from uv.lock, split into
# torch/torchaudio (installed from the CPU index) and everything else. The
# CUDA-only packages that the PyPI torch wheel pulls in (nvidia-*, cuda-*, triton) are
# dropped: the CPU wheels do not use them.
RUN uv export --format requirements-txt --no-hashes --no-emit-project --extra diarization \
        > /tmp/requirements-diarization.txt \
    && grep -E '^(torch|torchaudio)==' /tmp/requirements-diarization.txt > /tmp/requirements-torch.txt \
    && grep -v -E '^(torch|torchaudio|triton|nvidia-[a-z0-9-]+|cuda-(bindings|pathfinder|toolkit))==' /tmp/requirements-diarization.txt \
        > /tmp/requirements-rest.txt \
    && test "$(wc -l < /tmp/requirements-torch.txt)" -eq 2

# Layer 1: PyTorch CPU (~800MB) — must use CPU index to avoid 4GB CUDA bundle
# torchaudio required by pyannote.audio 4.x for resampling
RUN uv pip install --no-cache -r /tmp/requirements-torch.txt --index-url https://download.pytorch.org/whl/cpu

# Layer 2: every other locked dependency (pyannote.audio, torchcodec, ...) exactly
# as resolved in uv.lock. --no-deps stops a fresh resolve from PyPI, which would
# otherwise replace the pinned CPU torch 2.15 (pyannote.audio needs it) with the
# newest CUDA torch.
RUN uv pip install --no-cache --no-deps -r /tmp/requirements-rest.txt

# Layer 3: vtt-transcribe; its dependencies are all installed above.
COPY vtt_transcribe ./vtt_transcribe
RUN uv pip install --no-cache --no-deps . \
    && python -c "import torch; v = torch.__version__; assert v.startswith('2.15.') and v.endswith('+cpu'), v" \
    && if ls /opt/venv/lib/python3.13/site-packages | grep -q -E '^(nvidia|cuda_|triton)'; then \
           echo 'CUDA packages found in the CPU venv' >&2; exit 1; \
       fi

# Remove build tools
RUN apt-get purge -y gcc g++ && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd -m -u "$USER_UID" vttuser
WORKDIR /workspace
USER vttuser

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["vtt"]
